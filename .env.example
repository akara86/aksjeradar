# Kopier denne filen til ".env" og fyll inn det du vil bruke.
# .env skal ALDRI deles eller lastes opp til GitHub (den står i .gitignore).

# --- Telegram (anbefalt) ---
# 1) Åpne Telegram, søk opp @BotFather, send /newbot og følg instruksjonene -> du får et token.
# 2) Send en melding til den nye boten din.
# 3) Åpne https://api.telegram.org/bot<TOKEN>/getUpdates i nettleseren og finn "chat":{"id": ...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- E-post (valgfritt) ---
# Gmail: bruk et app-passord (Google-konto -> Sikkerhet -> App-passord), ikke vanlig passord.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
